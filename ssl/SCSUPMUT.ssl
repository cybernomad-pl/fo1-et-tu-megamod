/*

   Super Mutant - Invaders used in Boneyard

   MEGAMOD 2026-08-08 (Borys): HUNT CIVILIANS -- jak INVADER.ssl.
   Poza walka atakuje najblizszego cywila (attack() = wymusza combat).

*/

/* Include Files */
#include "define.h"
//#include "area/necropolis.h"

#define NAME                    SCRIPT_SCSUPMUT
//#define TOWN_REP_VAR            (GVAR_TOWN_REP_CATHEDRAL)

#include "command.h"
//#include "modreact.h"

/* Standard Script Procedures */
procedure start;
procedure critter_p_proc;
procedure destroy_p_proc;
procedure look_at_p_proc;
procedure pickup_p_proc;
procedure talk_p_proc;
procedure timed_event_p_proc;

procedure ScSupMut0;
procedure ScSupMut1;
procedure ScSupMut2;
procedure ScSupMut3;

procedure combat;
procedure goto_follmap;
procedure find_civilian;

variable tmp_herebefore;
variable tmp_hostile;
variable initial := 0;
variable in_timed_event;
variable weaponPtr;


procedure start begin
   if not(initial) then begin
      initial := 1;
      set_self_team(TEAM_NECROPOLIS_MUTANT);
      set_self_ai(AI_SUPER_MUTANT_NORMAL);
      self_rotate(random(0, 5));
      if (local_var(1) == 0) then begin
         set_local_var(1, 1);
         weaponPtr := create_object(PID_MINIGUN, 0, 0);
         add_obj_to_inven(self_obj, weaponPtr);
         wield_obj_critter(self_obj, weaponPtr);
         add_obj_to_inven(self_obj, create_object(PID_5MM_JHP, 0, 0));
      end
   end
end

// MEGAMOD: najblizszy zywy cywil (nie mutant, nie party gracza, nie
// dude) w promieniu 25 hexow. 0 gdy brak.
procedure find_civilian begin
   variable lst;
   variable obj;
   variable t;
   variable best;
   variable best_d;
   variable d;
   best := 0;
   best_d := 26;
   lst := list_begin(LIST_CRITTERS);
   obj := list_next(lst);
   while (obj) do begin
      if (obj != 0 and obj != self_obj and obj != dude_obj
          and not(is_critter_dead(obj))) then begin
         t := get_team(obj);
         if (t != TEAM_NECROPOLIS_MUTANT and t != TEAM_PLAYER) then begin
            /* MEGAMOD 2026-08-09: questowi NPC poza polowaniem
               (jak INVADER.ssl -- Ian/Tandi/Aradesh). */
            if (get_script(obj) != SCRIPT_IAN
                and get_script(obj) != SCRIPT_TANDI
                and get_script(obj) != SCRIPT_ARADESH) then begin
               d := tile_distance_objs(obj, self_obj);
               if (d < best_d) then begin
                  best := obj;
                  best_d := d;
               end
            end
         end
      end
      obj := list_next(lst);
   end
   list_end(lst);
   return best;
end

procedure critter_p_proc begin
   variable civ;
   if (global_var(GVAR_ENEMY_FOLL_INVADERS)) then begin
      tmp_hostile := 1;
   end
   // MEGAMOD: rzeznia -- atakuj najblizszego cywila (wymusza combat).
   if (not(combat_is_initialized)) then begin
      civ := find_civilian;
      if (civ != 0) then begin
         attack(civ);
         return;
      end
   end
   if (tmp_hostile and self_can_see_dude) then begin
      tmp_hostile := 0;
      attack(dude_obj);
   end
   else begin
      if (not(in_timed_event)) then begin
         in_timed_event := 1;
         add_timer_event(self_obj, game_ticks(random(6, 10)), random(1, 3));
      end
      if (self_can_see_dude and (tile_distance_objs(self_obj, dude_obj) < 6)) then begin
         if (local_var(0) == 0) then begin
            dialogue_system_enter;
         end
      end
   end
end

procedure destroy_p_proc begin
   if source_is_dude then begin
      set_global_var(GVAR_ENEMY_FOLL_INVADERS, 1);
   end
   inc_evil_critter
end

procedure look_at_p_proc begin
   script_overrides;
   display_msg(mstr(100));
end

procedure pickup_p_proc begin
   tmp_hostile := 1;
end

procedure talk_p_proc begin
   script_overrides;
   dude_look_at_self;
   if (local_var(0)) then begin
      call ScSupMut3;
   end
   else begin
      set_local_var(0, 1);
      start_dialog_at_node(ScSupMut0);
   end
end

procedure timed_event_p_proc begin
   if (fixed_param == 1) then
      self_rotate(random(0, 5));
   else
      self_walk_to_tile(tile_num_in_direction(self_tile, random(0, 5), random(1, 3)));
   in_timed_event := 0;
end

procedure ScSupMut0 begin
   Reply(101);
   NLowOption(102, combat);
   NOption(103, goto_follmap, 4);
   NOption(104, ScSupMut1, 4);
   NOption(105, combat, 4);
end

procedure ScSupMut1 begin
   Reply(106);
   NOption(107, goto_follmap, 4);
   NOption(108, ScSupMut2, 4);
   NOption(109, combat, 4);
end

procedure ScSupMut2 begin
   NMessage(110);
end

procedure ScSupMut3 begin
   float_msg(self_obj, mstr(111), FLOAT_MSG_NORMAL);
end

procedure combat begin
   tmp_hostile := 1;
end

procedure goto_follmap begin
   load_map("lafollwr.map", 10);
end
